#include <iostream>
#include <cstring>

int main() {
    //User inputs a C-string
    char cString[100];
    std::cout << "Enter a C-string: ";
    std::cin.getline(cString, 100);
    //use a pointer to find the length of the C-string
    char* ptr = cString;
    //display the length of the C-string
    std::cout << "The length of the C-string is: " << std::strlen(ptr) << std::endl;
}
