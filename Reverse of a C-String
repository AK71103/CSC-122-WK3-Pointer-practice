#include <iostream>
#include <cstring>

int main() {
    //User inputs a C-string
    char cString[100];
    std::cout << "Enter a C-string: ";
    std::cin.getline(cString, 100);
    //use a pointer to find the length of the C-string
    char* ptr = cString;
    //print the reverse of the C-string
    std::cout << "The reverse of the C-string is: ";
    for (int i = strlen(cString) - 1; i >= 0; i--) {
        std::cout << *(ptr + i);
    }
    std::cout << std::endl;
    return 0;
}
